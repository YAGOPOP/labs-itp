CompileFlags:
  Add:
    - -std=c++26
    - -Wall
    - -Wextra
    - -Wpedantic
    - -Wconversion
    - -Wshadow
    - -Wsign-conversion
    - -Wcast-qual
    - -Wformat=2
    - -Wundef
    - -Werror=return-type
    - -Wnull-dereference
    - -Wdouble-promotion
    - -Woverloaded-virtual
    - -Wnon-virtual-dtor
  CompilationDatabase: build/Debug
